# Formspree form ID — the part after /f/ in your endpoint URL.
# Create a form at https://formspree.io, then copy its ID here.
# Local dev: copy this file to `.env`. Production (GitHub Pages):
# set VITE_FORMSPREE_ID in the deploy workflow / repo secrets and
# expose it at build time, or commit a `.env.production`.
VITE_FORMSPREE_ID=your_form_id
